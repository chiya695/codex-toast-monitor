<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.18362.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CodexToastProbe</AssemblyName>
    <RootNamespace>CodexToastProbe</RootNamespace>
    <ApplicationIcon>Assets\CodexToastMonitor.ico</ApplicationIcon>
    <Product>Codex Toast Monitor</Product>
    <Description>将 ChatGPT Windows 通知安全转发到飞书</Description>
    <Version>0.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Windows.SDK.NET">
      <HintPath>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\10.0.26100.87\lib\net9.0\Microsoft.Windows.SDK.NET.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="WinRT.Runtime">
      <HintPath>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\10.0.26100.87\lib\net9.0\WinRT.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageDownload Include="Microsoft.Windows.SDK.NET.Ref" Version="[10.0.26100.87]" />
  </ItemGroup>
  <ItemGroup>
    <None Update="AppxManifest.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="config.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
